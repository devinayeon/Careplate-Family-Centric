<?xml version="1.0" encoding="UTF-8"?>
<!-- MySQL variant of phpunit.xml. Target is forced to the throwaway server 127.0.0.1:3407. Run it only through tools/ai-test-mysql.php. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3407" force="true"/>
        <env name="DB_DATABASE" value="careplate_ai_test" force="true"/>
        <env name="DB_USERNAME" value="root" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <env name="DB_SOCKET" value="" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="AI_ENABLED" value="false" force="true"/>
        <env name="AI_GEMINI_KEY" value="" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="GOOGLE_API_KEY" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config-testing-mysql.php" force="true"/>
        <env name="APP_SERVICES_CACHE" value="bootstrap/cache/services-testing-mysql.php" force="true"/>
        <env name="APP_PACKAGES_CACHE" value="bootstrap/cache/packages-testing-mysql.php" force="true"/>
        <env name="APP_ROUTES_CACHE" value="bootstrap/cache/routes-v7-testing-mysql.php" force="true"/>
        <env name="APP_EVENTS_CACHE" value="bootstrap/cache/events-testing-mysql.php" force="true"/>
    </php>
</phpunit>
