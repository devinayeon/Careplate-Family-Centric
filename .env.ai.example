# Template for a fresh AI worktree only. Never overwrite an existing .env or APP_KEY.
APP_NAME="Careplate AI MVP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
DB_CONNECTION=sqlite
DB_URL=
DB_DATABASE=database/careplate-ai-demo.sqlite
DB_FOREIGN_KEYS=true
SESSION_DRIVER=database
SESSION_COOKIE=careplate_ai_mvp_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BROADCAST_CONNECTION=log
LOG_CHANNEL=single
LOG_LEVEL=warning
AI_ENABLED=false
AI_GEMINI_KEY=
AI_GEMINI_MODEL=gemini-3.8-flash
AI_SCAN_MAX_BYTES=5242880
AI_SCAN_MAX_PIXELS=16000000
AI_SCAN_DEADLINE_SECONDS=25
AI_CHAT_DEADLINE_SECONDS=20
AI_CHAT_LEASE_SECONDS=35
AI_CONTEXT_TEXT_TOKEN_BUDGET=6000
AI_OCR_MAX_OUTPUT_TOKENS=4096
AI_CHAT_MAX_OUTPUT_TOKENS=2048
AI_CHAT_RETENTION_DAYS=7
NUTRITION_POLICY_STATUS=provisional
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
